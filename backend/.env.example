PORT=5000
# MongoDB connection URI (supports MONGO_URI, MONGODB_URI, or DATABASE_URL)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/flavor-fusion?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/flavor-fusion?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster-url>/flavor-fusion?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Client URL & CORS Configuration
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173

# Google Gemini API Configuration (Free Tier: get key from https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
